{
  "name": "stationly",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "generate": "pnpm --filter @stationly/protocol --filter @stationly/manifest-schema generate",
    "db:generate": "pnpm --filter @stationly/dispatch db:generate"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "7.0.2"
  }
}
